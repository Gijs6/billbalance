#!/bin/bash

setup() {
  i:npm_install
  migrate
}

serve() {
  npm run dev
}

migrate() {
  case "$1" in
    "") npm run db:migrate ;;
    add) npm run db:generate ;;
    *) _shake_err "usage: shake migrate [add]" ;;
  esac
}

seed() {
  npm run db:seed -- "$@"
}

test() {
  npm run test
}

check() {
  npm run lint
  npm run check
}

build() {
  npm run build
}

deploy() {
  local force=0
  for arg in "$@"; do
    [ "$arg" = "--force" ] && force=1
  done

  if ! test; then
    if [ "$force" -eq 1 ]; then
      echo "shake: tests failed, deploying anyway (--force)" >&2
    else
      _shake_err "tests failed; run 'shake deploy --force' to deploy anyway"
    fi
  fi

  build
  g:deploy
}
